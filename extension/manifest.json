{
  "manifest_version": 3,
  "name": "CA Desk Suite – GST Desk & Portal Helper",
  "version": "3.3.0",
  "description": "GST Desk (client master, GST registration filling, bulk GSTR-1/2B/3B downloads, Tally GST work) plus the CA Desk portal helper: login autofill, Tally link, GSTR-1 autopilot and filing-frequency checks. You type every CAPTCHA/OTP.",
  "permissions": [
    "alarms",
    "downloads",
    "nativeMessaging",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.gst.gov.in/*",
    "https://smishra724.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GST Desk (CA Desk Suite)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "manager.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gst.gov.in/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.gst.gov.in/*"
      ],
      "js": [
        "schema.js",
        "lists.js",
        "docs.js",
        "content.js",
        "returns.js",
        "regrun.js",
        "importer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://smishra724.github.io/gst-desk/*",
        "https://smishra724.github.io/ca-desk/*"
      ],
      "js": [
        "schema.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://smishra724.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "cad-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.gst.gov.in/*",
        "https://ewaybillgst.gov.in/*",
        "https://*.incometax.gov.in/*",
        "https://www.tdscpc.gov.in/*",
        "https://*.mca.gov.in/*",
        "https://*.epfindia.gov.in/*",
        "https://*.esic.gov.in/*",
        "https://udyamregistration.gov.in/*",
        "https://*.dgft.gov.in/*"
      ],
      "js": [
        "fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.gst.gov.in/*"
      ],
      "js": [
        "gstauto.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://return.gst.gov.in/*"
      ],
      "js": [
        "cad-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://services.gst.gov.in/services/searchtp*"
      ],
      "js": [
        "freq.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111",
  "web_accessible_resources": [
    {
      "resources": [
        "manager.html"
      ],
      "matches": [
        "https://smishra724.github.io/*"
      ]
    }
  ],
  "short_name": "CA Desk Suite"
}
