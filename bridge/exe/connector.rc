#include <windows.h>
1 ICON "../icon.ico"
1 RT_MANIFEST "setup.manifest"
1 VERSIONINFO
FILEVERSION VMAJ,VMIN,VPAT,0
PRODUCTVERSION VMAJ,VMIN,VPAT,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "SM Consultancy"
      VALUE "FileDescription", "CA Desk Connector"
      VALUE "ProductName", "CA Desk Connector"
      VALUE "FileVersion", VSTR
      VALUE "ProductVersion", VSTR
      VALUE "OriginalFilename", "CA-Desk-Connector.exe"
      VALUE "LegalCopyright", "SM Consultancy"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
